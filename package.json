          "group": "1_read@2"
        },
        {
          "command": "temcoKnowledge.addSource",
          "when": "view == temcoKnowledge.library",
          "group": "1_read@3"
        },
        {
          "command": "temcoKnowledge.selectProject",
          "when": "view == temcoKnowledge.library",
          "group": "2_work@1"
        },
        {
          "command": "temcoKnowledge.buildProject",
          "when": "view == temcoKnowledge.library",
          "group": "2_work@2"
        },
        {
          "command": "temcoKnowledge.runScript",
