        "icon": "$(cloud-download)"
      },
      {
        "command": "temcoKnowledge.revealSource",
        "title": "Open the Source",
        "icon": "$(link-external)"
      },
      {
        "command": "temcoKnowledge.setSourceBranch",
        "title": "Set the Branch to Read",
        "icon": "$(git-branch)"
      },
      {
        "command": "temcoKnowledge.removeSource",
        "title": "Forget the Source",
        "icon": "$(trash)"
      },
      {
        "command": "temcoKnowledge.aiPage",
        "title": "The AI",
        "icon": "$(hubot)"
      },
      {
        "command": "temcoKnowledge.readSource",
        "title": "Read a Source",
        "icon": "$(cloud-download)"
      },
      {
        "command": "temcoKnowledge.openFile",
        "title": "Open a Page File"
      },
      {
        "command": "temcoKnowledge.setToken",
        "title": "Set a GitHub Token",
        "icon": "$(key)"
      },
      {
        "command": "temcoKnowledge.format.pick",
        "title": "Format"
      },
      {
        "command": "temcoKnowledge.format.bold",
        "title": "Bold"
      },
      {
        "command": "temcoKnowledge.format.italic",
        "title": "Italic"
      },
      {
        "command": "temcoKnowledge.format.code",
        "title": "Inline Code"
      },
      {
        "command": "temcoKnowledge.format.heading",
        "title": "Heading Level"
      },
      {
        "command": "temcoKnowledge.format.bullet",
        "title": "Bullet List"
      },
      {
        "command": "temcoKnowledge.format.numbered",
        "title": "Numbered List"
      },
      {
        "command": "temcoKnowledge.format.task",
        "title": "Task List"
      },
      {
        "command": "temcoKnowledge.format.quote",
        "title": "Block Quote"
      },
      {
        "command": "temcoKnowledge.format.codeBlock",
        "title": "Code Block"
      },
      {
        "command": "temcoKnowledge.format.table",
        "title": "Table"
      },
      {
        "command": "temcoKnowledge.format.rule",
        "title": "Horizontal Rule"
      },
      {
        "command": "temcoKnowledge.format.callout",
        "title": "Callout"
      },
      {
        "command": "temcoKnowledge.format.link",
        "title": "Link"
      },
      {
        "command": "temcoKnowledge.format.linkPage",
        "title": "Link to a Page"
      },
      {
        "command": "temcoKnowledge.format.outline",
        "title": "Go to a Heading"
      },
      {
        "command": "temcoKnowledge.newPage",
        "title": "New Page",
        "icon": "$(new-file)"
      },
      {
        "command": "temcoKnowledge.newChapter",
        "title": "New Chapter",
        "icon": "$(new-folder)"
      },
      {
        "command": "temcoKnowledge.newPage.article",
        "title": "New Article Page"
      },
      {
        "command": "temcoKnowledge.newPage.task",
        "title": "New Task Page"
      },
      {
        "command": "temcoKnowledge.newPage.reference",
        "title": "New Reference Page"
      },
      {
        "command": "temcoKnowledge.newPage.troubleshooting",
