{
  "name": "temco-knowledge-extension",
  "displayName": "Temco Knowledge Studio",
  "description": "Temco's internal platform for product technical content: keeps documentation and training in step with the code, with a local AI drafting the updates.",
  "version": "0.0.1",
  "publisher": "temcocontrols",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/temcocontrols/temco-knowledge-extension.git"
  },
  "bugs": {
    "url": "https://github.com/temcocontrols/temco-knowledge-extension/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:temcoKnowledge.pages",
    "onView:temcoKnowledge.ai"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "temcoKnowledge",
          "title": "Temco Knowledge",
          "icon": "media/knowledge.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "temcoKnowledgePanel",
          "title": "Temco Knowledge",
          "icon": "media/knowledge.svg"
        }
      ]
    },
    "views": {
      "temcoKnowledge": [
        {
          "id": "temcoKnowledge.pages",
          "name": "Workspace"
        },
        {
          "id": "temcoKnowledge.library",
          "name": "Library"
        }
      ],
      "temcoKnowledgePanel": [
        {
          "type": "webview",
          "id": "temcoKnowledge.ai",
          "name": "Temco Knowledge"
        }
      ]
    },
    "commands": [
      {
        "command": "temcoKnowledge.showStatus",
        "title": "Temco Knowledge: Show Status"
      },
      {
        "command": "temcoKnowledge.validate",
        "title": "Validate",
        "icon": "$(check)"
      },
      {
        "command": "temcoKnowledge.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "temcoKnowledge.expandAll",
        "title": "Expand All",
        "icon": "$(expand-all)"
      },
      {
        "command": "temcoKnowledge.home",
        "title": "Home",
        "icon": "$(home)"
      },
      {
        "command": "temcoKnowledge.openRegistry",
        "title": "Open Registry",
        "icon": "$(json)"
      },
      {
        "command": "temcoKnowledge.openPage",
        "title": "Open Page",
        "icon": "$(go-to-file)"
      },
      {
        "command": "temcoKnowledge.revealPage",
        "title": "Reveal in Explorer",
        "icon": "$(folder-opened)"
      },
      {
        "command": "temcoKnowledge.models",
        "title": "Models and Runtime",
        "icon": "$(server-process)"
      },
      {
        "command": "temcoKnowledge.removeModel",
        "title": "Remove Model or Runtime",
        "icon": "$(trash)"
      },
      {
        "command": "temcoKnowledge.openModelFolder",
        "title": "Open Model Folder",
        "icon": "$(file-directory)"
      },
      {
        "command": "temcoKnowledge.aiDockRight",
        "title": "Show the AI in the Right Side Bar",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "temcoKnowledge.aiStatus",
        "title": "AI Status",
        "icon": "$(pulse)"
      },
      {
        "command": "temcoKnowledge.buildSite",
        "title": "Build the Site",
        "icon": "$(globe)"
      },
      {
        "command": "temcoKnowledge.buildHelp",
        "title": "Build the Offline Help",
        "icon": "$(book)"
      },
      {
        "command": "temcoKnowledge.stalenessReport",
        "title": "Documentation Owed",
        "icon": "$(report)"
      },
      {
        "command": "temcoKnowledge.startRegistry",
        "title": "Start a Registry",
        "icon": "$(new-file)"
      },
      {
        "command": "temcoKnowledge.feedback",
        "title": "Feedback by Owner",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "temcoKnowledge.catalog",
        "title": "The Catalog",
        "icon": "$(database)"
      },
      {
        "command": "temcoKnowledge.newProject",
        "title": "Create a Project",
        "icon": "$(new-folder)"
      },
      {
        "command": "temcoKnowledge.addSource",
        "title": "Add a Source",
        "icon": "$(add)"
      },
      {
        "command": "temcoKnowledge.openProject",
        "title": "Open a Project",
        "icon": "$(book)"
      },
      {
        "command": "temcoKnowledge.editProject",
        "title": "Edit a Project"
      },
      {
        "command": "temcoKnowledge.buildProject",
        "title": "Build the Project",
        "icon": "$(tools)"
      },
      {
        "command": "temcoKnowledge.openNeeds",
        "title": "What Needs Doing",
        "icon": "$(checklist)"
      },
      {
        "command": "temcoKnowledge.runScript",
        "title": "Run One of the Repository's Documentation Scripts",
        "icon": "$(run)"
      },
      {
        "command": "temcoKnowledge.runOwed",
        "title": "Run the Docs-Owed Check",
        "icon": "$(law)"
      },
      {
        "command": "temcoKnowledge.createPage",
        "title": "Create the Missing Page File"
      },
      {
        "command": "temcoKnowledge.openProjects",
        "title": "Projects",
        "icon": "$(list-flat)"
      },
      {
        "command": "temcoKnowledge.removeProject",
        "title": "Remove the Project",
        "icon": "$(trash)"
      },
      {
        "command": "temcoKnowledge.selectProject",
        "title": "Work on a Project",
        "icon": "$(pass-filled)"
      },
      {
        "command": "temcoKnowledge.clearProject",
        "title": "Stop Working on a Project",
        "icon": "$(circle-slash)"
      },
      {
        "command": "temcoKnowledge.readAllSources",
        "title": "Read Every Unread Source",
        "icon": "$(cloud-download)"
      },
      {
        "command": "temcoKnowledge.revealSource",
        "title": "Open the Source",
        "icon": "$(link-external)"
      },
      {
        "command": "temcoKnowledge.setSourceBranch",
        "title": "Set the Branch to Read",
        "icon": "$(git-branch)"
      },
      {
        "command": "temcoKnowledge.removeSource",
        "title": "Forget the Source",
        "icon": "$(trash)"
      },
      {
        "command": "temcoKnowledge.aiPage",
        "title": "The AI",
        "icon": "$(hubot)"
      },
      {
        "command": "temcoKnowledge.readSource",
        "title": "Read a Source",
        "icon": "$(cloud-download)"
      },
      {
        "command": "temcoKnowledge.openFile",
        "title": "Open a Page File"
      },
      {
        "command": "temcoKnowledge.setToken",
        "title": "Set a GitHub Token",
        "icon": "$(key)"
      },
      {
        "command": "temcoKnowledge.format.pick",
        "title": "Format"
      },
      {
        "command": "temcoKnowledge.format.bold",
        "title": "Bold"
      },
      {
        "command": "temcoKnowledge.format.italic",
        "title": "Italic"
      },
      {
        "command": "temcoKnowledge.format.code",
        "title": "Inline Code"
      },
      {
        "command": "temcoKnowledge.format.heading",
        "title": "Heading Level"
      },
      {
        "command": "temcoKnowledge.format.bullet",
        "title": "Bullet List"
      },
      {
        "command": "temcoKnowledge.format.numbered",
        "title": "Numbered List"
      },
      {
        "command": "temcoKnowledge.format.task",
        "title": "Task List"
      },
      {
        "command": "temcoKnowledge.format.quote",
        "title": "Block Quote"
      },
      {
        "command": "temcoKnowledge.format.codeBlock",
        "title": "Code Block"
      },
      {
        "command": "temcoKnowledge.format.table",
        "title": "Table"
      },
      {
        "command": "temcoKnowledge.format.rule",
        "title": "Horizontal Rule"
      },
      {
        "command": "temcoKnowledge.format.callout",
        "title": "Callout"
      },
      {
        "command": "temcoKnowledge.format.link",
        "title": "Link"
      },
      {
        "command": "temcoKnowledge.format.linkPage",
        "title": "Link to a Page"
      },
      {
        "command": "temcoKnowledge.format.outline",
        "title": "Go to a Heading"
      },
      {
        "command": "temcoKnowledge.newPage",
        "title": "New Page"
      },
      {
        "command": "temcoKnowledge.newChapter",
        "title": "New Chapter"
      },
      {
        "command": "temcoKnowledge.renamePage",
        "title": "Rename the Page Title"
      },
      {
        "command": "temcoKnowledge.movePageUp",
        "title": "Move the Page Up"
      },
      {
        "command": "temcoKnowledge.movePageDown",
        "title": "Move the Page Down"
      },
      {
        "command": "temcoKnowledge.retirePage",
        "title": "Retire the Page"
      }
    ],
    "submenus": [
      {
        "id": "temcoKnowledge.markdown",
        "label": "Temco Knowledge"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "temcoKnowledge.format.bold",
          "when": "editorLangId == markdown && resourceScheme == file",
          "group": "temcoKnowledge@1"
        },
        {
          "command": "temcoKnowledge.format.italic",
          "when": "editorLangId == markdown && resourceScheme == file",
          "group": "temcoKnowledge@2"
        },
        {
          "command": "temcoKnowledge.format.linkPage",
          "when": "editorLangId == markdown && resourceScheme == file",
          "group": "temcoKnowledge@3"
        },
        {
          "command": "temcoKnowledge.format.pick",
          "when": "editorLangId == markdown && resourceScheme == file",
          "group": "temcoKnowledge@4"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "temcoKnowledge.markdown",
          "when": "editorLangId == markdown && resourceScheme == file",
          "group": "temcoKnowledge@1"
        }
      ],
      "editor/context": [
        {
          "submenu": "temcoKnowledge.markdown",
          "when": "editorLangId == markdown && resourceScheme == file",
          "group": "temcoKnowledge@1"
        }
      ],
      "temcoKnowledge.markdown": [
        {
          "command": "temcoKnowledge.format.pick",
          "group": "0_top@1"
        },
        {
          "command": "temcoKnowledge.format.bold",
          "group": "1_inline@1"
        },
        {
          "command": "temcoKnowledge.format.italic",
          "group": "1_inline@2"
        },
        {
          "command": "temcoKnowledge.format.code",
          "group": "1_inline@3"
        },
        {
          "command": "temcoKnowledge.format.heading",
          "group": "2_blocks@1"
        },
        {
          "command": "temcoKnowledge.format.bullet",
          "group": "2_blocks@2"
        },
        {
          "command": "temcoKnowledge.format.numbered",
          "group": "2_blocks@3"
        },
        {
          "command": "temcoKnowledge.format.task",
          "group": "2_blocks@4"
        },
        {
          "command": "temcoKnowledge.format.quote",
          "group": "2_blocks@5"
        },
        {
          "command": "temcoKnowledge.format.codeBlock",
          "group": "2_blocks@6"
        },
        {
          "command": "temcoKnowledge.format.table",
          "group": "2_blocks@7"
        },
        {
          "command": "temcoKnowledge.format.rule",
          "group": "2_blocks@8"
        },
        {
          "command": "temcoKnowledge.format.callout",
          "group": "2_blocks@9"
        },
        {
          "command": "temcoKnowledge.format.link",
          "group": "3_insert@1"
        },
        {
          "command": "temcoKnowledge.format.linkPage",
          "group": "3_insert@2"
        },
        {
          "command": "temcoKnowledge.format.outline",
          "group": "4_navigate@1"
        }
      ],
      "view/title": [
        {
          "command": "temcoKnowledge.home",
          "when": "view == temcoKnowledge.pages",
          "group": "navigation@0"
        },
        {
          "command": "temcoKnowledge.validate",
          "when": "view == temcoKnowledge.pages",
          "group": "navigation@1"
        },
        {
          "command": "temcoKnowledge.refresh",
          "when": "view == temcoKnowledge.pages",
          "group": "navigation@2"
        },
        {
          "command": "temcoKnowledge.expandAll",
          "when": "view == temcoKnowledge.pages",
          "group": "navigation@3"
        },
        {
          "command": "temcoKnowledge.newProject",
          "when": "view == temcoKnowledge.library",
          "group": "navigation@0"
        },
        {
          "command": "temcoKnowledge.openProjects",
          "when": "view == temcoKnowledge.library",
          "group": "navigation@1"
        },
        {
          "command": "temcoKnowledge.openNeeds",
          "when": "view == temcoKnowledge.library",
          "group": "navigation@2"
        },
        {
          "command": "temcoKnowledge.readAllSources",
          "when": "view == temcoKnowledge.library",
          "group": "1_read@1"
        },
        {
          "command": "temcoKnowledge.readSource",
          "when": "view == temcoKnowledge.library",
          "group": "1_read@2"
        },
        {
          "command": "temcoKnowledge.addSource",
          "when": "view == temcoKnowledge.library",
          "group": "1_read@3"
        },
        {
          "command": "temcoKnowledge.selectProject",
          "when": "view == temcoKnowledge.library",
          "group": "2_work@1"
        },
        {
          "command": "temcoKnowledge.buildProject",
          "when": "view == temcoKnowledge.library",
          "group": "2_work@2"
        },
        {
          "command": "temcoKnowledge.runScript",
          "when": "view == temcoKnowledge.library",
          "group": "3_run@1"
        },
        {
          "command": "temcoKnowledge.stalenessReport",
          "when": "view == temcoKnowledge.library",
          "group": "3_run@2"
        },
        {
          "command": "temcoKnowledge.catalog",
          "when": "view == temcoKnowledge.library",
          "group": "4_catalog@1"
        },
        {
          "command": "temcoKnowledge.setToken",
          "when": "view == temcoKnowledge.library",
          "group": "9_settings@1"
        },
        {
          "command": "temcoKnowledge.aiPage",
          "when": "view == temcoKnowledge.ai",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "temcoKnowledge.openPage",
          "when": "view == temcoKnowledge.pages && viewItem =~ /^(page|missingPage)$/",
          "group": "inline"
        },
        {
          "command": "temcoKnowledge.revealPage",
          "when": "view == temcoKnowledge.pages && viewItem == page",
          "group": "1_open@1"
        },
        {
          "command": "temcoKnowledge.createPage",
          "when": "view == temcoKnowledge.pages && viewItem == missingPage",
          "group": "1_open@0"
        },
        {
          "command": "temcoKnowledge.openRegistry",
          "when": "view == temcoKnowledge.pages && viewItem =~ /^(area|chapter|folder)$/",
          "group": "1_open@2"        },
        {
          "command": "temcoKnowledge.newPage",
          "when": "view == temcoKnowledge.pages && viewItem =~ /^(area|chapter|folder)$/",
          "group": "2_new@1"
        },
        {
          "command": "temcoKnowledge.newChapter",
          "when": "view == temcoKnowledge.pages && viewItem =~ /^(area|folder)$/",
          "group": "2_new@2"
        },
        {
          "command": "temcoKnowledge.renamePage",
          "when": "view == temcoKnowledge.pages && viewItem =~ /^(page|missingPage)$/",
          "group": "3_edit@1"
        },
        {
          "command": "temcoKnowledge.movePageUp",
          "when": "view == temcoKnowledge.pages && viewItem =~ /^(page|missingPage)$/",
          "group": "3_edit@2"
        },
        {
          "command": "temcoKnowledge.movePageDown",
          "when": "view == temcoKnowledge.pages && viewItem =~ /^(page|missingPage)$/",
          "group": "3_edit@3"
        },
        {
          "command": "temcoKnowledge.retirePage",
          "when": "view == temcoKnowledge.pages && viewItem =~ /^(page|missingPage)$/",
          "group": "9_retire@1"
        },
        {
          "command": "temcoKnowledge.openProject",
          "when": "view == temcoKnowledge.library && viewItem == project",
          "group": "inline"
        },
        {
          "command": "temcoKnowledge.readSource",
          "when": "view == temcoKnowledge.library && viewItem == source",
          "group": "inline"
        },
        {
          "command": "temcoKnowledge.openFile",
          "when": "view == temcoKnowledge.library && viewItem == page",
          "group": "inline"
        },
        {
          "command": "temcoKnowledge.selectProject",
          "when": "view == temcoKnowledge.library && viewItem == project",
          "group": "1_work@1"
        },
        {
          "command": "temcoKnowledge.editProject",
          "when": "view == temcoKnowledge.library && viewItem == project",
          "group": "1_work@2"
        },
        {
          "command": "temcoKnowledge.addSource",
          "when": "view == temcoKnowledge.library && viewItem == project",
          "group": "1_work@3"
        },
        {
          "command": "temcoKnowledge.buildProject",
          "when": "view == temcoKnowledge.library && viewItem == project",
          "group": "1_work@4"
        },
        {
          "command": "temcoKnowledge.removeProject",
          "when": "view == temcoKnowledge.library && viewItem == project",
          "group": "9_forget@1"
        },
        {
          "command": "temcoKnowledge.revealSource",
          "when": "view == temcoKnowledge.library && viewItem == source",
          "group": "1_open@1"
        },
        {
          "command": "temcoKnowledge.setSourceBranch",
          "when": "view == temcoKnowledge.library && viewItem == source",
          "group": "1_open@2"
        },
        {
          "command": "temcoKnowledge.removeSource",
          "when": "view == temcoKnowledge.library && viewItem == source",
          "group": "9_forget@1"
        },
        {
          "command": "temcoKnowledge.aiPage",
          "when": "view == temcoKnowledge.library && viewItem == ai",
          "group": "1_open@1"
        },
        {
          "command": "temcoKnowledge.aiDockRight",
          "when": "view == temcoKnowledge.library && viewItem == ai",
          "group": "1_place@1"
        },
        {
          "command": "temcoKnowledge.aiStatus",
          "when": "view == temcoKnowledge.library && viewItem == ai",
          "group": "1_open@2"
        },
        {
          "command": "temcoKnowledge.models",
          "when": "view == temcoKnowledge.library && viewItem == ai",
          "group": "1_open@3"
        },
        {
          "command": "temcoKnowledge.openModelFolder",
          "when": "view == temcoKnowledge.library && viewItem == ai",
          "group": "1_open@4"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "temcoKnowledge.library",
        "contents": "Nothing recorded yet.\n\nA project is what you manage: name it, then give it the sources it is built from — a repository at a branch you choose, a folder on this machine, or an archive. Read a source and its pages appear in the Workspace, beside the code they document.\n\n[Create a project](command:temcoKnowledge.newProject) · [Add a source](command:temcoKnowledge.addSource)"
      }
    ],
    "configuration": {
      "title": "Temco Knowledge",
      "properties": {
        "temcoKnowledge.ai.modelFolder": {
          "type": "string",
          "default": "",
          "markdownDescription": "Where the local runtime and its models are downloaded. Empty keeps them in the extension's own storage — never in a repository."
        },
        "temcoKnowledge.ai.allowUnpinned": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Allow downloading a catalog entry whose checksum is not pinned yet. Each such download asks for confirmation first, and the checksum it turns out to have is recorded, so a later change is still noticed."
        },
        "temcoKnowledge.ai.runtime": {
          "type": "string",
          "default": "",
          "markdownDescription": "Id of the local runtime in use. Chosen from **Temco Knowledge: Models and Runtime**."
        },
        "temcoKnowledge.ai.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "Id of the model in use. Chosen from **Temco Knowledge: Models and Runtime**."
        },
        "temcoKnowledge.ai.idleMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "markdownDescription": "How long the local server may sit unused before it is stopped and its memory released. `0` keeps it running until the window closes."
        },
        "temcoKnowledge.start.open": {
          "type": "string",
          "enum": [
            "project",
            "page",
            "home",
            "none"
          ],
          "enumDescriptions": [
            "The dashboard of the project being worked on. With no project, the page you were last on.",
            "The page you were last working on in the project being worked on. With none, that project's dashboard.",
            "The platform's home page.",
            "Nothing — no tab opens by itself."
          ],
          "default": "project",
          "markdownDescription": "What opens in the editor when the extension is activated. Each choice falls through to the next when it cannot be honoured: `project`, then the page you were last on, then the home page. Only `none` opens nothing."
        },
        "temcoKnowledge.organisation": {
          "type": "string",
          "default": "temcocontrols",
          "markdownDescription": "The GitHub organisation the dashboard links to for a starting point. Nothing is read from it automatically."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node scripts/check-commands.mjs",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.6.0"
  }
}
