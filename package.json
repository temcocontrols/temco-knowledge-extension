{
  "name": "temco-knowledge-extension",
  "displayName": "Temco Knowledge Studio",
  "description": "Temco's internal platform for product technical content: keeps documentation and training in step with the code, with a local AI drafting the updates.",
  "version": "0.0.1",
  "publisher": "temcocontrols",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:temcoKnowledge.pages",
    "onView:temcoKnowledge.ai"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "temcoKnowledge",
          "title": "Temco Knowledge",
          "icon": "media/knowledge.svg"
        }
      ]
    },
    "views": {
      "temcoKnowledge": [
        {
          "id": "temcoKnowledge.pages",
          "name": "Content"
        }
      ],
      "panel": [
        {
          "type": "webview",
          "id": "temcoKnowledge.ai",
          "name": "Temco Knowledge"
        }
      ]
    },
    "commands": [
      {
        "command": "temcoKnowledge.showStatus",
        "title": "Temco Knowledge: Show Status"
      },
      {
        "command": "temcoKnowledge.validate",
        "title": "Validate",
        "icon": "$(check)"
      },
      {
        "command": "temcoKnowledge.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "temcoKnowledge.openRegistry",
        "title": "Open Registry",
        "icon": "$(json)"
      },
      {
        "command": "temcoKnowledge.openPage",
        "title": "Open Page",
        "icon": "$(go-to-file)"
      },
      {
        "command": "temcoKnowledge.revealPage",
        "title": "Reveal in Explorer",
        "icon": "$(folder-opened)"
      },
      {
        "command": "temcoKnowledge.models",
        "title": "Models and Runtime",
        "icon": "$(server-process)"
      },
      {
        "command": "temcoKnowledge.removeModel",
        "title": "Remove Model or Runtime",
        "icon": "$(trash)"
      },
      {
        "command": "temcoKnowledge.openModelFolder",
        "title": "Open Model Folder",
        "icon": "$(file-directory)"
      },
      {
        "command": "temcoKnowledge.aiStatus",
        "title": "AI Status",
        "icon": "$(pulse)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "temcoKnowledge.validate",
          "when": "view == temcoKnowledge.pages",
          "group": "navigation@1"
        },
        {
          "command": "temcoKnowledge.openRegistry",
          "when": "view == temcoKnowledge.pages",
          "group": "navigation@2"
        },
        {
          "command": "temcoKnowledge.refresh",
          "when": "view == temcoKnowledge.pages",
          "group": "navigation@3"
        },
        {
          "command": "temcoKnowledge.models",
          "when": "view == temcoKnowledge.pages",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "temcoKnowledge.openPage",
          "when": "view == temcoKnowledge.pages && viewItem == page",
          "group": "inline"
        },
        {
          "command": "temcoKnowledge.revealPage",
          "when": "view == temcoKnowledge.pages && viewItem == page",
          "group": "1_open@1"
        },
        {
          "command": "temcoKnowledge.openRegistry",
          "when": "view == temcoKnowledge.pages && viewItem =~ /^(area|chapter|folder)$/",
          "group": "1_open@2"
        }
      ]
    },
    "configuration": {
      "title": "Temco Knowledge",
      "properties": {
        "temcoKnowledge.ai.modelFolder": {
          "type": "string",
          "default": "",
          "markdownDescription": "Where the local runtime and its models are downloaded. Empty keeps them in the extension's own storage — never in a repository."
        },
        "temcoKnowledge.ai.allowUnpinned": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Allow downloading a catalog entry whose checksum is not pinned yet. Each such download asks for confirmation first, and the checksum it turns out to have is recorded, so a later change is still noticed."
        },
        "temcoKnowledge.ai.runtime": {
          "type": "string",
          "default": "",
          "markdownDescription": "Id of the local runtime in use. Chosen from **Temco Knowledge: Models and Runtime**."
        },
        "temcoKnowledge.ai.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "Id of the model in use. Chosen from **Temco Knowledge: Models and Runtime**."
        },
        "temcoKnowledge.ai.idleMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "markdownDescription": "How long the local server may sit unused before it is stopped and its memory released. `0` keeps it running until the window closes."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.6.0"
  }
}
