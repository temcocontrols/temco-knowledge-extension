        {
          "command": "temcoKnowledge.copyPath",
          "when": "view == temcoKnowledge.pages",
          "group": "2_show@3"
        },
        {
          "command": "temcoKnowledge.copyRelativePath",
          "when": "view == temcoKnowledge.pages",
          "group": "2_show@4"
        },
        {
          "command": "temcoKnowledge.renamePage",
          "when": "view == temcoKnowledge.pages",
          "group": "3_edit@1"
        },
        {
          "command": "temcoKnowledge.movePageUp",
          "when": "view == temcoKnowledge.pages",
          "group": "3_edit@2"
        },
        {
          "command": "temcoKnowledge.movePageDown",
          "when": "view == temcoKnowledge.pages",
          "group": "3_edit@3"
        },
        {
          "command": "temcoKnowledge.retirePage",
          "when": "view == temcoKnowledge.pages",
          "group": "4_retire@1"
        },
        {
          "command": "temcoKnowledge.home",
          "when": "view == temcoKnowledge.pages",
          "group": "5_view@1"
        },
        {
          "command": "temcoKnowledge.validate",
          "when": "view == temcoKnowledge.pages",
          "group": "5_view@2"
        },
        {
          "command": "temcoKnowledge.openRegistry",
          "when": "view == temcoKnowledge.pages",
          "group": "9_registry@1"
